{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiraiHub",
  "version": "2.0.5",
  "identifier": "com.admin.miraihub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiraiHub",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "backgroundColor": "#00000000",
        "title": "MiraiHub",
        "width": 420,
        "height": 280,
        "center": true,
        "decorations": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "XiangZi",
    "copyright": "Copyright © 2026 XiangZi. All rights reserved.",
    "category": "DeveloperTool",
    "shortDescription": "一站式服务器与开发基础设施工作台",
    "longDescription": "MiraiHub 是基于 Tauri 2、Rust 与 Vue 3 构建的桌面工作台，将 SSH 终端、远端文件传输、数据库管理、服务器监控与 AI Agent 集中到同一个应用中。",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
