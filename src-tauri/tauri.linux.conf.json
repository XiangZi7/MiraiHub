{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MiraiHub",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "backgroundColor": "#00000000",
        "title": "MiraiHub",
        "width": 420,
        "height": 280,
        "center": true,
        "decorations": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": false,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3"]
      }
    }
  }
}
