{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-editor",
  "description": "Native remote text editors: window-local event subscriptions and interface zoom only",
  "windows": ["remote-editor-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:allow-set-webview-zoom"
  ]
}
