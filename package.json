{
  "name": "miraihub",
  "private": true,
  "version": "4.0.10",
  "description": "一站式服务器与开发基础设施工作台：SSH 终端、远端文件、数据库管理、服务器监控与 AI Agent",
  "author": "XiangZi <793923048@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/XiangZi7/MiraiHub",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiangZi7/MiraiHub.git"
  },
  "bugs": "https://github.com/XiangZi7/MiraiHub/issues",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build:app": "vite build",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "version:set": "node scripts/release-version.mjs",
    "version:check": "node scripts/release-version.mjs --check",
    "release": "node scripts/release.mjs",
    "release:build": "node scripts/build-release.mjs",
    "updater:setup": "node scripts/setup-updater.mjs",
    "format": "prettier --write \"src/**/*.{vue,ts,js,jsx,html,css,scss,md}\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/language": "^6.13.0",
    "@codemirror/legacy-modes": "^6.5.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@iconify/vue": "^5.0.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "@vueuse/core": "^14.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "exceljs": "4.4.0",
    "markdown-it": "^15.0.1",
    "pinia": "^4.0.3",
    "sql-formatter": "^15.9.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.128",
    "@iconify-json/vscode-icons": "^1.2.96",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.14"
  }
}
